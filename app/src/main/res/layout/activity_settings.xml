<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/back_button_size"
            android:layout_height="@dimen/back_button_size"
            android:layout_marginStart="@dimen/back_button_margin"
            android:layout_marginTop="@dimen/back_button_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/arrow_back"
            app:tint="@color/pm_black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/header_title_margin_to_button"
            android:layout_marginTop="@dimen/margin_top"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/settings"
            android:textColor="@color/pm_black"
            android:textSize="@dimen/text_size_heading" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_item_height"
        android:layout_marginTop="@dimen/margin_after_header"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/ys_display_regular"
        android:paddingHorizontal="@dimen/margin_side"
        android:text="@string/dark_theme"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_side"
        android:text="@string/share_app"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_body"
        app:drawableEndCompat="@drawable/share"
        app:drawableTint="@color/pm_gray" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_side"
        android:text="@string/support"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_body"
        app:drawableEndCompat="@drawable/support"
        app:drawableTint="@color/pm_gray" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_item_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:fontFamily="@font/ys_display_regular"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_side"
        android:text="@string/user_agreement"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_body"
        app:drawableEndCompat="@drawable/arrow_forward"
        app:drawableTint="@color/pm_gray" />
</LinearLayout>




