<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_blue"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_side"
    android:paddingBottom="@dimen/margin_bottom">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/header_height"
        android:fontFamily="@font/ys_display_medium"
        android:paddingTop="@dimen/margin_top"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_heading" />

    <Button
        android:id="@+id/button_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_after_header"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:fontFamily="@font/ys_display_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/search"
        android:textAllCaps="false"
        android:textColor="@color/pm_black"
        android:textSize="@dimen/text_size_heading"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/search"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/button_icon_padding"
        app:iconTint="@color/pm_black"
        app:rippleColor="?attr/colorControlHighlight" />

    <Button
        android:id="@+id/button_library"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_between_object"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:fontFamily="@font/ys_display_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/library"
        android:textAllCaps="false"
        android:textColor="@color/pm_black"
        android:textSize="@dimen/text_size_heading"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/library"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/button_icon_padding"
        app:iconTint="@color/pm_black"
        app:rippleColor="?attr/colorControlHighlight" />

    <Button
        android:id="@+id/button_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_between_object"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:fontFamily="@font/ys_display_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/settings"
        android:textAllCaps="false"
        android:textColor="@color/pm_black"
        android:textSize="@dimen/text_size_heading"
        app:cornerRadius="@dimen/button_corner_radius"
        app:icon="@drawable/settings"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/button_icon_padding"
        app:iconTint="@color/pm_black"
        app:rippleColor="?attr/colorControlHighlight" />
</LinearLayout>